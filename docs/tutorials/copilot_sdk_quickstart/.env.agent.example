# Copilot SDK Quickstart — environment template.
#
# Copy this file into your repo-root `.env.agent` (or merge selectively) and
# fill in real values. Everything below is commented out so nothing leaks by
# accident when this file is committed.
#
# `agent.py` loads `.env.agent` via python-dotenv on startup.

# ============================================================================
# LLM provider (default: logged-in Copilot subscription)
# ============================================================================
# Copilot SDK BYOK is *key-based only* — Microsoft Entra ID is NOT supported
# by ProviderConfig. The MAF / openai-agents quickstarts' Entra path has no
# equivalent here.
#
# Supported values for LLM_PROVIDER:
#   copilot           — logged-in user (default; needs `copilot auth login`)
#   azure_openai_key  — BYOK against Azure OpenAI
#   openai            — BYOK against public OpenAI / OpenAI-compatible
# LLM_PROVIDER=copilot

# Default Copilot subscription — pick any model the CLI advertises.
# COPILOT_MODEL="gpt-5.2"

# ============================================================================
# Alternative LLM provider: Azure OpenAI (BYOK, api key only)
# ============================================================================
# LLM_PROVIDER=azure_openai_key
# AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"   # host only, no /openai/v1
# AZURE_OPENAI_API_KEY="<your-key>"
# AZURE_OPENAI_DEPLOYMENT_NAME="<your-deployment-id>"
# API_VERSION="2024-10-21"

# ============================================================================
# Alternative LLM provider: public OpenAI / OpenAI-compatible
# ============================================================================
# LLM_PROVIDER=openai
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ============================================================================
# Energy systems MCP server (local Docker; see README for spin-up steps)
# ============================================================================
# ENERGYSYSTEMS_MCP_URL="http://localhost:8022/mcp"
