# OpenAI Agents Quickstart — environment template.
#
# Copy this file into your repo-root `.env.agent` (or merge selectively) and
# fill in real values. Everything below is commented out so nothing leaks by
# accident when this file is committed.
#
# `agent.py` loads `.env.agent` via python-dotenv on startup.

# ============================================================================
# LLM provider (default: Azure OpenAI via Entra ID)
# ============================================================================
# LLM_PROVIDER=azure_openai_entra
# AZURE_OPENAI_ENDPOINT="https://<your-aoai-host>/<path>"
# AOAI_SCOPE="<token-scope-for-your-endpoint>"      # standard AOAI:
#                                                   #   https://cognitiveservices.azure.com/.default
#                                                   # internal/gateway endpoints may use a different
#                                                   # scope — check with your endpoint owner.
# API_VERSION="preview"
#
# NOTE on API_VERSION: the openai-agents SDK routes through either
# /chat/completions (OpenAIChatCompletionsModel) or /responses
# (OpenAIResponsesModel — the default in chat_client.py). Public Azure
# OpenAI accepts dated previews (e.g. "2025-04-01-preview"); some internal
# gateways only accept the floating tags "preview" or "v1".
#
# TRAPI quirk: the floating "preview" / "v1" tags work for
# /chat/completions but currently return 404 on /openai/responses — use a
# dated preview (e.g. "2025-04-01-preview") when AZURE_OPENAI_API_KIND is
# left at the default (responses).

# Deployment ID. AZURE_OPENAI_DEPLOYMENT_NAME takes precedence over
# MODEL_DEPLOYMENT_NAME so the tutorial's deployment can be set independently
# of any Foundry-style MODEL_DEPLOYMENT_NAME used elsewhere in the repo.
# Some internal/gateway endpoints require dated deployment IDs
# of the form "<model>_<YYYY-MM-DD>", e.g. "gpt-5.2-codex_2026-01-14".
#
# IMPORTANT: codex-style deployments often only expose /responses, which is
# the default in chat_client.py. If your endpoint is chat-completions-only,
# set AZURE_OPENAI_API_KIND=chat_completions below.
# AZURE_OPENAI_DEPLOYMENT_NAME="<your-deployment-id>"
# MODEL_DEPLOYMENT_NAME="<fallback-deployment-id>"

# Switch the Azure path from /responses (default) to /chat/completions.
# AZURE_OPENAI_API_KIND=chat_completions

# ============================================================================
# Chemistry MCP server (local Docker; see README for spin-up steps) — OPTIONAL
# ============================================================================
# CHEMISTRY_MCP_URL="http://localhost:8020/mcp"

# ============================================================================
# OpenAI Agents SDK tracing — OPTIONAL
# ============================================================================
# chat_client.py disables tracing in-process (set_tracing_disabled). Set this
# env var to keep traces fully off-host as well.
# OPENAI_AGENTS_DISABLE_TRACING=1

# ============================================================================
# Alternative LLM provider: public OpenAI
# ============================================================================
# LLM_PROVIDER=openai
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"

