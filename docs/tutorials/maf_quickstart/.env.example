# MAF Quickstart — environment template.
#
# Copy this file into your repo-root `.env` (or merge selectively) and fill in
# real values. Everything below is commented out so nothing leaks by accident
# when this file is committed.
#
# See also the repo-level .env.example for non-tutorial settings.

# ============================================================================
# LLM provider (default: Azure OpenAI via Entra ID)
# ============================================================================
# LLM_PROVIDER=azure_openai_entra
# AZURE_OPENAI_ENDPOINT="https://<your-aoai-host>/<path>"
# AOAI_SCOPE="<token-scope-for-your-endpoint>"      # standard AOAI:
#                                                   #   https://cognitiveservices.azure.com/.default
#                                                   # internal/gateway endpoints may use a different
#                                                   # scope — check with your endpoint owner.
# API_VERSION="preview"
#
# NOTE: agent-framework >= 1.2 routes Azure OpenAI calls through the
# Responses API (/responses). On the public Azure OpenAI surface this
# accepts the usual dated previews (e.g. "2025-04-01-preview"). Some
# internal gateways only accept the floating tags "preview" or "v1";
# dated strings return `BadRequest: API version not supported`. If you
# see that error, set API_VERSION="preview".

# Deployment ID. AZURE_OPENAI_DEPLOYMENT_NAME takes precedence over
# MODEL_DEPLOYMENT_NAME so the tutorial's deployment can be set independently
# of any Foundry-style MODEL_DEPLOYMENT_NAME used elsewhere in the repo.
# Some internal/gateway endpoints require dated deployment IDs
# of the form "<model>_<YYYY-MM-DD>", e.g. "gpt-5.2-codex_2026-01-14".
# AZURE_OPENAI_DEPLOYMENT_NAME="<your-deployment-id>"
# MODEL_DEPLOYMENT_NAME="<fallback-deployment-id>"

# ============================================================================
# Data lake — OPTIONAL
# Pick ONE backend (or leave both unset to skip Step B entirely).
# ============================================================================

# Backend A) Azure AI Search-backed catalog (production / shared deployments).
# DATA_LAKE_SEARCH_ENDPOINT="https://<your-search-service>.search.windows.net"
# DATA_LAKE_CATALOG_INDEX_NAME="<your-catalog-index>"

# IMPORTANT: agora-workbench's auth layer treats a non-empty AZURE_SEARCH_API_KEY
# as "use API key auth" — even if the value is a placeholder. Either set a real
# key or leave it unset (commented out) to use Entra ID auth via `az login`.
# AZURE_SEARCH_API_KEY="<real-search-key-or-leave-unset>"

# Backend B) Local YAML catalog (no Azure required; BM25 keyword search).
# Used only when DATA_LAKE_SEARCH_ENDPOINT is unset. Path is relative to the
# repo root (or absolute). See src/data_lake/README.md for the schema.
# DATA_LAKE_LOCAL_CATALOG="src/data_lake/tools/adapters/catalog.example.yaml"

# ============================================================================
# Chemistry MCP server (local Docker; see README for spin-up steps) — OPTIONAL
# ============================================================================
# CHEMISTRY_MCP_URL="http://localhost:8020/mcp"

# ============================================================================
# Alternative LLM providers (uncomment one; see llm.py for details)
# ============================================================================
#
# Standard Azure OpenAI via Entra:
# LLM_PROVIDER=azure_openai_entra
# AOAI_SCOPE="https://cognitiveservices.azure.com/.default"
#
# Azure OpenAI via API key:
# LLM_PROVIDER=azure_openai_apikey
# AZURE_OPENAI_API_KEY="<your-api-key>"
#
# OpenAI (api.openai.com):
# LLM_PROVIDER=openai
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"
#
# Ollama (local model server):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="llama3.1"
