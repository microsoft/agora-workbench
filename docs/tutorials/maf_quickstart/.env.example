# Tutorial-specific environment variables.
# Copy this to .env in the repo root (or merge into existing .env).
# Most of these mirror the repo-level .env.example; values here are tuned
# for the quickstart's TRAPI + chemistry MCP scenario.

# === LLM (TRAPI Azure OpenAI via Entra ID — default and tested path) ===
LLM_PROVIDER=azure_openai_entra
AZURE_OPENAI_ENDPOINT="https://trapi.research.microsoft.com/gcr/shared"
AOAI_SCOPE="api://trapi/.default"
API_VERSION="2025-04-01-preview"
# TRAPI uses dated/versioned deployment IDs (e.g. gpt-5.4_2026-03-05,
# gpt-4o_2024-11-20). AZURE_OPENAI_DEPLOYMENT_NAME takes precedence over
# MODEL_DEPLOYMENT_NAME so the tutorial's TRAPI deployment can be set
# independently of the Foundry-style MODEL_DEPLOYMENT_NAME used elsewhere.
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5.4_2026-03-05"
# MODEL_DEPLOYMENT_NAME="gpt-4o"  # fallback if AZURE_OPENAI_DEPLOYMENT_NAME unset

# === Data Lake (Azure AI Search-backed catalog) ===
DATA_LAKE_SEARCH_ENDPOINT="https://agora-ai-search.search.windows.net"
DATA_LAKE_CATALOG_INDEX_NAME="artifact-registry"

# IMPORTANT: agora-workbench's auth layer treats a non-empty AZURE_SEARCH_API_KEY
# as "use API key auth" — even if the value is the placeholder string from the
# repo-level .env.example. Either set a real key or leave AZURE_SEARCH_API_KEY
# unset (commented out) to use Entra ID auth via az login.
# AZURE_SEARCH_API_KEY="<real-search-key-or-leave-unset>"

# === Chemistry MCP server (local Docker; see README for spin-up steps) ===
CHEMISTRY_MCP_URL="http://localhost:8020/mcp"

# --- Alternative LLM providers (uncomment to use; see llm.py for details) ---
#
# Standard Azure OpenAI via Entra (non-TRAPI):
# LLM_PROVIDER=azure_openai_entra
# AOAI_SCOPE="https://cognitiveservices.azure.com/.default"
#
# Azure OpenAI via API key:
# LLM_PROVIDER=azure_openai_apikey
# AZURE_OPENAI_API_KEY="..."
#
# OpenAI (api.openai.com):
# LLM_PROVIDER=openai
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"
#
# Ollama (local model server):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="llama3.1"
