# Exclude non-runtime files from Docker build context
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.egg-info
**/.venv
.git
.github
docs
logo_ideas

# Exclude test and dev files from the agora_workbench package image
src/agora_workbench/**/tests
src/agora_workbench/code_execution/README.md
src/agora_workbench/code_execution/catalog.example.yaml
