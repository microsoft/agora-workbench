{# Jinja2 template for a standard domain server Dockerfile stage.
   Rendered by `build.py generate` for each domain with a domain.yaml config.
   Usage: uv run python src/code_execution/docker/build.py generate
#}

# ============================================================================
# Stage: {{ config.service_name }}{% if config.description %} ({{ config.description }}){% endif %}

# ============================================================================
FROM base AS {{ config.service_name }}
{% if config.system_packages %}
USER root

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    {{ config.system_packages | join(" \\\n    ") }} && \
    rm -rf /var/lib/apt/lists/*

USER appuser
{% endif %}
# Copy {{ config.name }} server code
COPY --chown=appuser:appuser domains/{{ config.name }}/server /app/domains/{{ config.name }}/server
{%- for extra_file in config.extra_files %}
COPY --chown=appuser:appuser domains/{{ config.name }}/{{ extra_file }} /app/domains/{{ config.name }}/{{ extra_file }}
{%- endfor %}
{%- for key, value in config.extra_env.items() %}

ENV {{ key }}="{{ value }}"
{%- endfor %}

CMD ["python", "-m", "{{ config.module }}"]
