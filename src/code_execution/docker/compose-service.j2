{# Jinja2 template for a docker-compose service entry.
   Rendered by `build.py generate` for each domain with a domain.yaml config.
   The rendered block is inserted under the `services:` key.
   Assumes YAML anchors *common-build, *base-env, *trusted-hosts, and
   *common-healthcheck are defined at the top of the compose file.
#}
  {{ config.service_name }}:
    build:
      <<: *common-build
      target: {{ config.service_name }}
    command: ["python", "-m", "{{ config.module }}"]
    ports:
      - "{{ config.port }}:8000"
    volumes:
      - ~/.azure:/root/.azure:rw
{%- for vol in config.volumes %}
      - {{ vol }}
{%- endfor %}
    env_file:
      - ../../.env
    environment:
{%- if config.trusted_hosts %}
      <<: [*base-env, *trusted-hosts]
{%- else %}
      <<: *base-env
{%- endif %}
{%- for key, value in config.extra_env.items() %}
      {{ key }}: "{{ value }}"
{%- endfor %}
{%- if config.depends_on %}
    depends_on:
{%- for dep in config.depends_on %}
      - {{ dep }}
{%- endfor %}
{%- endif %}
    healthcheck:
      <<: *common-healthcheck
{%- if config.gpu %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
{%- elif config.memory_limit %}
    deploy:
      resources:
        limits:
          memory: {{ config.memory_limit }}
{%- endif %}
