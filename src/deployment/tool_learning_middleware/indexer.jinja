{
  "name": "vignette-indexer-{{ SOURCE_ID }}",
  "dataSourceName": "vignette-ds-{{ SOURCE_ID }}",
  "targetIndexName": "{{ TARGET_INDEX_NAME }}",
  "description": "Indexes tool-learning vignettes from Azure Table Storage ({{ SOURCE_ID }}) into {{ TARGET_INDEX_NAME }}.",
  "schedule": {
    "interval": "PT5M"
  },
  "skillsetName": "vignette-skillset-{{ SOURCE_ID }}",
  "parameters": {
    "configuration": {}
  },
  "fieldMappings": [
    {
      "sourceFieldName": "RowKey",
      "targetFieldName": "vignette_id",
      "mappingFunction": {
        "name": "base64Encode"
      }
    },
    {
      "sourceFieldName": "kind",
      "targetFieldName": "kind"
    },
    {
      "sourceFieldName": "scope",
      "targetFieldName": "scope"
    },
    {
      "sourceFieldName": "tenant_id",
      "targetFieldName": "tenant_id"
    },
    {
      "sourceFieldName": "user_id",
      "targetFieldName": "user_id"
    },
    {
      "sourceFieldName": "tool_name",
      "targetFieldName": "tool_name"
    },
    {
      "sourceFieldName": "tool_version",
      "targetFieldName": "tool_version"
    },
    {
      "sourceFieldName": "error_class",
      "targetFieldName": "error_class"
    },
    {
      "sourceFieldName": "confidence",
      "targetFieldName": "confidence"
    },
    {
      "sourceFieldName": "title",
      "targetFieldName": "title"
    },
    {
      "sourceFieldName": "summary",
      "targetFieldName": "summary"
    },
    {
      "sourceFieldName": "tags_json",
      "targetFieldName": "tags_json"
    },
    {
      "sourceFieldName": "updated_at",
      "targetFieldName": "updated_at"
    },
    {
      "sourceFieldName": "payload_json",
      "targetFieldName": "payload_json"
    }
  ],
  "outputFieldMappings": [
    {
      "sourceFieldName": "/document/content_vector",
      "targetFieldName": "content_vector"
    }
  ]
}
